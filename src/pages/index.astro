---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import Hero from '../components/Hero.astro';
import ReviewCarousel from '../components/ReviewCarousel.astro';
import ServiceTiles from '../components/ServiceTiles.astro';
import { mapsHref } from '../lib/site';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const blogCovers: Record<string, string> = {
  'que-es-inspeccion-camara-tv': '/2026/05/Bluered1.jpg',
  'como-detectar-una-fuga-de-agua-oculta-antes-de-que-provoque-danos-graves':
    '/2023/05/localizacion-redes-ocultas.webp',
  'diferencias-entre-desatasco-manual-agua-a-presion-y-fresado-de-tuberias':
    '/2023/05/sistema-fresado-tuberias-cuadrada.webp',
};
const blogCoverFallback = '/2026/05/Bluered3.jpg';

const process = [
  {
    n: '01',
    title: 'Inspección gratuita',
    text: 'Tras recibir la solicitud del cliente, el departamento técnico se desplaza al lugar para visualizar la incidencia.',
  },
  {
    n: '02',
    title: 'Estudio detallado',
    text: 'Nuestro departamento técnico plantea las posibles soluciones, priorizando aquellas que ocasionen el menor impacto.',
  },
  {
    n: '03',
    title: 'Presupuesto personalizado',
    text: 'Se valoran las diferentes soluciones aportadas, pensando siempre en la mayor calidad al menor costo.',
  },
  {
    n: '04',
    title: 'Financiación a medida',
    text: 'Ofrecemos la posibilidad de financiar los trabajos, ajustándonos a las necesidades del cliente.',
  },
];
---

<BaseLayout
  title="Saneamientos, desatrancos y poceros en Madrid"
  description="Blue Red Saneamientos: desatrancos 24h, inspección con cámara y rehabilitación de tuberías sin obra en Madrid y el sur metropolitano."
>
  <Hero />

  <section class="process-band">
    {
      process.map((step, i) => (
        <article class="process-row" style={`--n: ${i}`} data-reveal>
          <span class="process-row-n" aria-hidden="true">
            {step.n}
          </span>
          <div class="process-row-copy">
            <h2>
              <span aria-hidden="true">↓</span>
              {step.title}
            </h2>
            <p>{step.text}</p>
          </div>
        </article>
      ))
    }
  </section>

  <section class="bg-white">
    <div class="page-wrap py-20 sm:py-24">
      <div class="mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end" data-reveal>
        <div>
          <p class="section-kicker">Servicios</p>
          <h2 class="section-title">Qué podemos hacer</h2>
        </div>
        <p class="section-lead">
          Comunidades, locales y particulares. Si no sabes qué pedir, llámanos: te decimos si va
          cámara, desatranco o rehabilitación.
        </p>
      </div>
      <ServiceTiles />
    </div>
  </section>

  <section class="bg-white">
    <div class="page-wrap py-20 sm:py-24">
      <div class="about-split">
        <div class="about-photo" data-reveal>
          <img
            src="/2026/05/Bluered3.jpg"
            alt="Unidad de Blue Red para trabajos sin obra"
            width="1200"
            height="800"
          />
        </div>
        <div data-reveal>
          <p class="section-kicker">Empresa</p>
          <h2 class="section-title">Técnicos propios, no un call center</h2>
          <div class="prose-br mt-6">
            <p>
              En Blue Red llevamos más de 15 años en limpieza de tuberías, desatrancos y
              reparación de averías. Rápido y con el menor destrozo, para que un problema de red
              no frene tu casa, tu local o tu comunidad.
            </p>
            <p>
              Comercial, técnico y operarios en la misma cadena. Nuestro aval son las obras:
              inspección, fresado, packer y manga continua cuando se puede evitar la zanja.
            </p>
          </div>
          <a href="/quienes-somos" class="btn btn-outline mt-7">Quiénes somos</a>
        </div>
      </div>
    </div>
  </section>

  <section class="review-section">
    <div class="page-wrap pt-20 sm:pt-24">
      <div class="mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end" data-reveal>
        <div>
          <p class="section-kicker">Opiniones</p>
          <h2 class="section-title">Lo que dicen en Google</h2>
        </div>
        <a href={mapsHref} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
          Ver en Google
        </a>
      </div>
    </div>
    <ReviewCarousel />
  </section>

  <section class="page-wrap py-20 sm:py-24">
    <div class="mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end" data-reveal>
      <div>
        <p class="section-kicker">Blog</p>
        <h2 class="section-title">Últimos artículos</h2>
      </div>
      <a href="/blog" class="btn btn-outline">Ver blog</a>
    </div>
    <div class="blog-grid">
      {
        posts.map((post, i) => (
          <a
            href={`/blog/${post.id}`}
            class:list={['blog-card', i === 0 && 'blog-card--featured']}
            data-reveal
          >
            <span class="blog-card-media">
              <img src={blogCovers[post.id] ?? blogCoverFallback} alt="" width="1200" height="800" />
            </span>
            <span class="blog-card-body">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('es-ES', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
                <em>{post.data.minutes} min</em>
              </time>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span>Leer más</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <CTABanner />
</BaseLayout>
