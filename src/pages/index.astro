---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import Hero from '../components/Hero.astro';
import ReviewCarousel from '../components/ReviewCarousel.astro';
import ServiceTiles from '../components/ServiceTiles.astro';
import ProcessArt from '../components/ProcessArt.astro';
import AboutTabs from '../components/AboutTabs.astro';
import { mapsEmbedSrc, mapsHref, site, telHref } from '../lib/site';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const blogCovers: Record<string, string> = {
  'que-es-inspeccion-camara-tv': '/2026/05/Bluered1.jpg',
  'como-detectar-una-fuga-de-agua-oculta-antes-de-que-provoque-danos-graves':
    '/2023/05/localizacion-redes-ocultas.webp',
  'diferencias-entre-desatasco-manual-agua-a-presion-y-fresado-de-tuberias':
    '/2023/05/sistema-fresado-tuberias-cuadrada.webp',
};
const blogCoverFallback = '/2026/05/Bluered3.jpg';
---

<BaseLayout
  title="Reparación de tuberías sin obra y desatrancos en Madrid"
  description="Blue Red Saneamientos en Leganés: reparación de tuberías sin obra, desatrancos 24h, pocería, inspección TV y rehabilitación en Madrid. 24 horas, 365 días. 91 705 65 15."
>
  <div class="home-hero-wrap">
    <Hero />

    <section class="lead-band" aria-labelledby="empresa-lider">
    <div class="page-wrap lead-band-inner">
      <div class="lead-band-copy" data-reveal>
        <p class="lead-band-kicker">Blue Red Saneamientos</p>
        <h2 id="empresa-lider">
          Empresa
          <span class="lead-lider">
            líder
            <svg class="lead-lider-ring" viewBox="0 0 86 44" aria-hidden="true">
              <path
                pathLength="1"
                d="M42.2 3.6c23.8-1.2 40.6 9.2 39.6 19.8-1.2 12.2-19.6 18.8-40.4 18.4C19.6 41.4 3.4 33.8 4.2 21.2 5 8.2 21.8 4.6 42.2 3.6Z"
              ></path>
            </svg>
          </span>
          con más de 15 años de experiencia
        </h2>
        <p>
          Pocería, inspección con cámara y rehabilitación sin zanja en Madrid. Técnicos propios,
          no un call center, y salida 24 horas.
        </p>
        <a href="/quienes-somos" class="btn btn-white mt-6">Quiénes somos</a>
      </div>
      <div class="lead-band-truck" data-reveal>
        <img
          src="/camion-hero.png"
          alt="Camión de Blue Red Saneamientos"
          width="974"
          height="616"
        />
      </div>
    </div>
    </section>
  </div>

  <section class="service-band" aria-labelledby="servicios-home">
    <ServiceTiles />
  </section>

  <section class="process-band" aria-labelledby="proceso-home" data-process>
    <div class="page-wrap">
      <p class="section-kicker">Cómo trabajamos</p>
      <h2 id="proceso-home" class="section-title">De la inspección al presupuesto</h2>
      <div class="process-pipeline">
        <div class="process-track" aria-hidden="true">
          <div class="process-track-fill"></div>
        </div>
        <ol class="process-steps">
          <li data-process-step class="is-active is-current">
            <span class="process-node">01</span>
            <ProcessArt id="inspect" />
            <h3>Inspección gratuita</h3>
            <p>
              Tras la solicitud, el departamento técnico se desplaza al lugar para visualizar la
              incidencia.
            </p>
          </li>
          <li data-process-step>
            <span class="process-node">02</span>
            <ProcessArt id="study" />
            <h3>Estudio detallado</h3>
            <p>
              Planteamos las posibles soluciones priorizando las que ocasionen el menor impacto.
            </p>
          </li>
          <li data-process-step>
            <span class="process-node">03</span>
            <ProcessArt id="quote" />
            <h3>Presupuesto personalizado</h3>
            <p>
              Valoramos las opciones pensando en la mayor calidad al menor costo.
            </p>
          </li>
          <li data-process-step>
            <span class="process-node">04</span>
            <ProcessArt id="finance" />
            <h3>Financiación a medida</h3>
            <p>
              Si lo necesitas, financiamos los trabajos ajustándonos a cada cliente.
            </p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="page-wrap py-20 sm:py-24">
      <AboutTabs />
    </div>
  </section>

  <section class="location-band" aria-labelledby="localizacion-home">
    <div class="page-wrap location-split">
      <div data-reveal>
        <p class="section-kicker">Localización</p>
        <h2 id="localizacion-home" class="section-title">Taller en Leganés, servicio en Madrid</h2>
        <p class="section-lead mt-5">
          Estamos en Calle Trigo 1, Nave 9, Leganés. Salimos 24 horas a toda la Comunidad de
          Madrid: desatrancos, pocería, inspección TV y reparación de tuberías sin obra.
        </p>
        <dl class="location-facts">
          <div>
            <dt>Dirección</dt>
            <dd>
              <a href={mapsHref} target="_blank" rel="noopener noreferrer">
                {site.address.street}<br />
                {site.address.postalCode} {site.address.city}, {site.address.region}
              </a>
            </dd>
          </div>
          <div>
            <dt>Horario</dt>
            <dd>24 horas · 365 días</dd>
          </div>
          <div>
            <dt>Teléfono</dt>
            <dd>
              <a href={telHref}>{site.phoneDisplay}</a>
            </dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </dd>
          </div>
        </dl>
      </div>
      <div class="contact-map-card" data-reveal>
        <iframe
          title={`Taller de Blue Red Saneamientos en ${site.address.street}, ${site.address.city}`}
          src={mapsEmbedSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <a class="contact-map-open" href={mapsHref} target="_blank" rel="noreferrer">
          Abrir en Maps
        </a>
      </div>
    </div>
  </section>

  <section class="review-section">
    <div class="page-wrap pt-20 sm:pt-24">
      <div class="mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end" data-reveal>
        <div>
          <p class="section-kicker">Nuestros clientes opinan</p>
          <h2 class="section-title">Nuestros clientes nos avalan</h2>
        </div>
        <a href={mapsHref} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
          Ver en Google
        </a>
      </div>
    </div>
    <ReviewCarousel />
  </section>

  <section class="page-wrap py-20 sm:py-24">
    <div class="mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end" data-reveal>
      <div>
        <p class="section-kicker">Blog</p>
        <h2 class="section-title">Últimos artículos</h2>
      </div>
      <a href="/blog" class="btn btn-outline">Ver blog</a>
    </div>
    <div class="blog-grid">
      {
        posts.map((post, i) => (
          <a
            href={`/blog/${post.id}`}
            class:list={['blog-card', i === 0 && 'blog-card--featured']}
            data-reveal
          >
            <span class="blog-card-media">
              <img src={blogCovers[post.id] ?? blogCoverFallback} alt="" width="1200" height="800" />
            </span>
            <span class="blog-card-body">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('es-ES', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
                <em>{post.data.minutes} min</em>
              </time>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span>Leer más</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <CTABanner />
</BaseLayout>
