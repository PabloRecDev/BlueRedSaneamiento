---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="No encontrado" description="La página no existe.">
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <p class="text-sm font-medium text-secondary">Error 404</p>
    <h1 class="mt-2 font-display text-4xl font-semibold text-primary md:text-5xl">
      Esta página no existe
    </h1>
    <p class="mt-4 max-w-md text-base-content/70">
      Puede que el enlace esté desactualizado. Vuelve al inicio o mira los servicios.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn-secondary">Inicio</a>
      <a href="/servicios" class="btn btn-outline">Servicios</a>
    </div>
  </section>
</BaseLayout>
