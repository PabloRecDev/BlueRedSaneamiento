---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import { serviceFallback, serviceImages } from '../../lib/services';

const services = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Servicios de saneamiento y pocería"
  description="Desatrancos 24h, cámaras de inspección, reparación sin obra, fresado, localización de redes, válvulas antiretorno y obras de pocería en Madrid."
>
  <section class="bg-white">
    <div class="page-wrap py-10 sm:py-20">
      <div class="about-values-head" data-reveal>
        <p class="about-values-kicker">Catálogo</p>
        <h1 class="section-title">Qué hacemos</h1>
        <p class="section-lead">
          Si no tienes claro qué necesitas, llama: el técnico te dice si va cámara, desatranco o
          rehabilitación.
        </p>
      </div>

      <div class="svc-catalog">
        {
          services.map((service) => (
            <a href={`/servicios/${service.id}`} class="svc-catalog-card" data-reveal>
              <span class="svc-catalog-media">
                <img
                  src={serviceImages[service.id] ?? serviceFallback}
                  alt=""
                  width="1200"
                  height="800"
                />
              </span>
              <span class="svc-catalog-copy">
                <p>{service.data.eyebrow}</p>
                <h2>{service.data.title}</h2>
                <span>{service.data.description}</span>
                <em>Ver servicio</em>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <CTABanner />
</BaseLayout>
