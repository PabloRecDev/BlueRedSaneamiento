---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import TabbedMedia from '../../components/TabbedMedia.astro';
import { site, telHref } from '../../lib/site';
import { serviceFallback, serviceIcons, serviceImages } from '../../lib/services';

export async function getStaticPaths() {
  const services = await getCollection('servicios');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const all = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
const hero = serviceImages[service.id] ?? serviceFallback;
const systems = service.data.systems ?? [];
const faq = service.data.faq ?? [];
const systemsTitle = service.data.systemsTitle ?? 'Cómo lo hacemos';
const icon = serviceIcons[service.id];

const methodTabs = systems.map((item, i) => ({
  id: `${service.id}-${i}`,
  label: item.kicker,
  title: item.title,
  text: item.text,
  image: item.image,
  badge: item.kicker,
  icon,
}));

const faqJsonLd =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      }
    : null;

const cta =
  service.id === 'desatrancos'
    ? {
        title: 'Desatrancos urgentes 24h en Madrid',
        text: 'Flota propia, succión y alta presión. Salimos el mismo día. Toda la Comunidad de Madrid.',
      }
    : service.id === 'inspeccion-tv'
      ? {
          title: 'Pide una inspección con cámara',
          text: 'Informe, plano AutoCAD y vídeo. De 32 mm a 600 mm. Diagnóstico sin romper.',
        }
      : service.id === 'localizacion-redes-ocultas'
        ? {
            title: 'Localiza la red antes de romper',
            text: 'Arquetas, pozos y roturas en el punto exacto. Menos pica, menos sorpresas.',
          }
        : service.id === 'fresado-tuberias'
          ? {
              title: '¿Raíces u hormigón en el tubo?',
              text: 'Fresado de tuberías y bajantes de 50 a 250 mm. Pasa codos. Sin sustituir el tramo.',
            }
          : service.id === 'valvulas-antiretorno'
            ? {
                title: '¿El agua te vuelve por el desagüe?',
                text: 'Válvula antiretorno: corta inundaciones y olores. Autónomas, sin luz ni mantenimiento continuo.',
              }
            : service.id === 'poceria'
              ? {
                  title: 'Poceros en Madrid, 24 horas',
                  text: 'Zanja, arquetas, bajantes y acometidas a Canal de Isabel II. Cuadrilla propia y presupuesto claro.',
                }
              : {
                  title: 'Pide presupuesto sin compromiso',
                  text: 'Rehabilitación de tuberías sin obra, desatrancos en Madrid y pocería. Técnicos propios, 24 horas.',
                };
---

<BaseLayout title={service.data.title} description={service.data.description}>
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
  <article class="svc-page">
    <section class="bg-white">
      <div class="page-wrap py-16 sm:py-20">
        <div class="about-values-head" data-reveal>
          <p class="about-values-kicker">{service.data.eyebrow}</p>
          <h1 class="section-title">{service.data.title}</h1>
          <p class="section-lead">{service.data.description}</p>
          <div class="svc-actions">
            <a href={telHref} class="btn btn-primary">Llamar {site.phoneDisplay}</a>
            <a href="/contacto" class="btn btn-outline">Pedir inspección</a>
          </div>
        </div>

        <div class="about-values-body svc-intro">
          <div class="prose-br" data-reveal>
            <Content />
          </div>
          <figure class="about-values-media" data-reveal>
            <img src={hero} alt={service.data.title} width="1200" height="800" />
            <figcaption>{service.data.impact}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    {
      methodTabs.length > 0 && (
        <section class="svc-method">
          <div class="page-wrap py-16 sm:py-20">
            <TabbedMedia kicker="Método" title={systemsTitle} tabs={methodTabs} />
          </div>
        </section>
      )
    }

    {
      faq.length > 0 && (
        <section class="faq-band">
          <div class="page-wrap py-16 sm:py-20">
            <div class="faq-split">
              <div class="faq-intro" data-reveal>
                <p class="about-values-kicker">Dudas</p>
                <h2 class="section-title">Preguntas frecuentes</h2>
                <p class="section-lead">
                  Lo que más nos preguntan sobre {service.data.title.toLowerCase()}. Si no está aquí,
                  llama y te lo aclaramos.
                </p>
                <a href={telHref} class="btn btn-primary mt-5">
                  Llamar {site.phoneDisplay}
                </a>
              </div>
              <div class="faq-list">
                {faq.map((item, index) => (
                  <details class="faq-item" name="servicio-faq" open={index === 0} data-reveal>
                    <summary>
                      <span class="faq-num">{String(index + 1).padStart(2, '0')}</span>
                      <span class="faq-q">{item.q}</span>
                      <span class="faq-toggle" aria-hidden="true"></span>
                    </summary>
                    <div class="faq-a">
                      <p>{item.a}</p>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          </div>
        </section>
      )
    }

    <section class="service-more-band">
      <div class="page-wrap py-16 sm:py-20">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-3" data-reveal>
          <div>
            <p class="about-values-kicker">También hacemos</p>
            <h2 class="section-title">Otros servicios</h2>
          </div>
          <a href="/servicios" class="btn btn-outline">Ver todos</a>
        </div>
        <div class="svc-more">
          {
            all
              .filter((item) => item.id !== service.id)
              .map((item) => (
                <a href={`/servicios/${item.id}`} class="svc-more-card" data-reveal>
                  <span class="svc-more-media">
                    <img
                      src={serviceImages[item.id] ?? serviceFallback}
                      alt=""
                      width="640"
                      height="400"
                    />
                  </span>
                  <span class="svc-more-copy">
                    <p>{item.data.eyebrow}</p>
                    <strong>{item.data.title}</strong>
                  </span>
                </a>
              ))
          }
        </div>
      </div>
    </section>
  </article>

  <CTABanner title={cta.title} text={cta.text} />
</BaseLayout>
