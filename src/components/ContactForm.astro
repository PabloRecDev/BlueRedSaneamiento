---
import { whatsappHref } from '../lib/site';

const fallback = whatsappHref('Hola, necesito información de Blue Red Saneamientos.');
---

<form class="card rounded-md border border-base-300 bg-base-100 shadow-sm" data-contact-form>
  <div class="card-body gap-4">
    <input type="text" name="company" class="hidden" tabindex="-1" autocomplete="off" />

    <div class="grid gap-4 sm:grid-cols-2">
      <label class="form-control w-full">
        <span class="label-text mb-1.5">Nombre</span>
        <input required name="name" class="input input-bordered w-full rounded-md" />
      </label>
      <label class="form-control w-full">
        <span class="label-text mb-1.5">Teléfono</span>
        <input required name="phone" type="tel" class="input input-bordered w-full rounded-md" />
      </label>
    </div>

    <label class="form-control w-full">
      <span class="label-text mb-1.5">Email</span>
      <input name="email" type="email" class="input input-bordered w-full rounded-md" />
    </label>

    <div class="grid gap-4 sm:grid-cols-2">
      <label class="form-control w-full">
        <span class="label-text mb-1.5">Tipo</span>
        <select name="type" class="select select-bordered w-full rounded-md">
          <option value="urgencia">Urgencia 24h</option>
          <option value="presupuesto">Presupuesto</option>
          <option value="mantenimiento">Mantenimiento</option>
          <option value="inspeccion">Inspección TV</option>
        </select>
      </label>
      <label class="form-control w-full">
        <span class="label-text mb-1.5">Zona</span>
        <input name="zone" placeholder="Madrid, Leganés…" class="input input-bordered w-full rounded-md" />
      </label>
    </div>

    <label class="form-control w-full">
      <span class="label-text mb-1.5">Qué está pasando</span>
      <textarea required name="message" rows="4" class="textarea textarea-bordered w-full rounded-md"></textarea>
    </label>

    <button type="submit" class="btn btn-secondary w-full">Enviar consulta</button>
    <p class="text-sm text-base-content/60">
      Si el correo no está configurado, te abriremos WhatsApp con el mensaje listo.
      <a class="link" href={fallback}>Escribir ahora</a>.
    </p>
    <p data-form-status class="hidden text-sm"></p>
  </div>
</form>
