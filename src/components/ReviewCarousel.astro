---
import { reviews } from '../lib/site';
---

<div class="review-carousel" aria-label="Reseñas de Google">
  <div class="review-track">
    {
      [0, 1].map((copy) => (
        <div class="review-set" aria-hidden={copy === 1 ? 'true' : undefined}>
          {reviews.map((review) => (
            <blockquote class="review-card">
              <div class="review-card-top">
                <span class="review-google" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M21.6 12.23c0-.74-.07-1.45-.19-2.13H12v4.03h5.38a4.6 4.6 0 0 1-2 3.02v2.5h3.24c1.89-1.74 2.98-4.3 2.98-7.42Z"></path>
                    <path fill="#34A853" d="M12 22c2.7 0 4.96-.9 6.61-2.35l-3.24-2.5c-.9.6-2.05.96-3.37.96-2.59 0-4.78-1.75-5.56-4.1H3.1v2.58A10 10 0 0 0 12 22Z"></path>
                    <path fill="#FBBC05" d="M6.44 13.99A6.01 6.01 0 0 1 6.13 12c0-.69.12-1.36.31-1.99V7.43H3.1A10 10 0 0 0 2 12c0 1.61.39 3.14 1.1 4.57l3.34-2.58Z"></path>
                    <path fill="#EA4335" d="M12 5.96c1.47 0 2.79.5 3.82 1.5l2.87-2.87C16.95 2.97 14.7 2 12 2 7.96 2 4.47 4.31 3.1 7.43l3.34 2.58C7.22 7.7 9.41 5.96 12 5.96Z"></path>
                  </svg>
                  Google
                </span>
                <span class="review-stars" aria-label={copy === 0 ? '5 estrellas' : undefined}>
                  {Array.from({ length: review.stars }).map(() => (
                    <svg viewBox="0 0 12 12" aria-hidden="true">
                      <path d="M6 1.1 7.5 4.2l3.4.5-2.45 2.4.6 3.4L6 8.9 3.95 10.5l.6-3.4L2.1 4.7l3.4-.5L6 1.1Z"></path>
                    </svg>
                  ))}
                </span>
              </div>
              <p>“{review.quote}”</p>
              <footer>Reseña de Google</footer>
            </blockquote>
          ))}
        </div>
      ))
    }
  </div>
</div>
