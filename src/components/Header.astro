---
import { getCollection } from 'astro:content';
import { nav, site, telHref, whatsappHref } from '../lib/site';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const whatsapp = whatsappHref('Hola, necesito ayuda con un problema de saneamiento.');
const services = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
const servicesOpen = path === '/servicios' || path.startsWith('/servicios/');

function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}
---

<header data-header class="site-header sticky top-0 z-50">
  <div class="site-nav-wrap">
    <div class="site-topbar bg-secondary text-secondary-content">
      <div class="page-wrap flex h-9 items-center justify-between gap-3 text-[12px] font-medium">
      <p class="flex min-w-0 items-center gap-2">
        <span class="inline-flex size-1.5 shrink-0 rounded-full bg-white"></span>
        <span>Urgencias 24h / 365 días</span>
        <span class="hidden text-white/75 sm:inline">· {site.address.city}, Madrid</span>
      </p>
      <div class="flex items-center gap-2 sm:gap-3">
        <a href={telHref} class="inline-flex items-center gap-1.5 transition-opacity hover:opacity-80">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-3.5">
            <path fill-rule="evenodd" d="M1.5 4.5A3 3 0 0 1 4.5 1.5h1.372c.86 0 1.61.586 1.819 1.42l.741 2.964a1.875 1.875 0 0 1-.47 1.807l-1.06 1.06a.75.75 0 0 0-.137.86 12.04 12.04 0 0 0 6.724 6.724.75.75 0 0 0 .86-.137l1.06-1.06a1.875 1.875 0 0 1 1.807-.47l2.964.741c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-.375C8.552 22.5 1.5 15.448 1.5 6.375V4.5Z" clip-rule="evenodd"></path>
          </svg>
          <span class="hidden sm:inline">{site.phoneDisplay}</span>
          <span class="sm:hidden">Llamar</span>
        </a>
        <span class="hidden h-3 w-px bg-white/30 md:block"></span>
        <a href={`mailto:${site.email}`} class="hidden items-center gap-1.5 transition-opacity hover:opacity-80 md:inline-flex">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-3.5">
            <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z"></path>
            <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z"></path>
          </svg>
          {site.email}
        </a>
        <span class="hidden h-3 w-px bg-white/30 sm:block"></span>
        <a href={whatsapp} class="inline-flex items-center gap-1.5 transition-opacity hover:opacity-80">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-3.5">
            <path d="M12.04 2C6.58 2 2.15 6.4 2.15 11.83c0 1.74.46 3.38 1.27 4.8L2 22l5.52-1.44a10 10 0 0 0 4.52 1.09h.01c5.46 0 9.89-4.4 9.89-9.83C21.94 6.4 17.5 2 12.04 2Zm5.77 13.94c-.24.67-1.4 1.24-1.93 1.32-.5.07-1.12.1-1.81-.11-.42-.13-.95-.31-1.64-.6-2.89-1.25-4.77-4.16-4.91-4.36-.14-.2-1.15-1.53-1.15-2.92 0-1.39.73-2.07.99-2.35.26-.28.57-.35.76-.35h.54c.17 0 .41-.06.64.49.24.56.8 1.94.87 2.08.07.14.12.3.02.49-.1.2-.14.31-.29.48-.14.17-.3.37-.43.5-.14.14-.29.3-.12.58.17.28.75 1.24 1.61 2.01 1.11.99 2.05 1.3 2.34 1.44.29.14.46.12.63-.07.17-.2.73-.85.93-1.14.2-.3.39-.24.66-.14.26.1 1.68.79 1.97.94.29.14.48.21.55.33.07.12.07.67-.17 1.34Z"></path>
          </svg>
          WhatsApp
        </a>
      </div>
    </div>
    </div>

    <div class="site-nav text-primary-content">
    <div class="page-wrap flex h-16 items-center justify-between gap-4">
      <Logo />

      <nav class="hidden items-center lg:flex" aria-label="Principal">
        <ul class="flex items-center gap-0.5">
          {
            nav.map((item) =>
              item.href === '/servicios' ? (
                <li class="site-dd" data-nav-dd>
                  <button
                    type="button"
                    class:list={['site-nav-link site-dd-trigger', servicesOpen && 'is-active']}
                    aria-expanded="false"
                    aria-haspopup="true"
                  >
                    <span class="site-nav-text">{item.label}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="site-dd-chevron" aria-hidden="true">
                      <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
                    </svg>
                  </button>
                  <div class="site-dd-menu">
                    <div class="site-dd-list">
                      <p class="site-dd-kicker">Servicios</p>
                      {services.map((service) => (
                        <a
                          href={`/servicios/${service.id}`}
                          class:list={['site-dd-item', path === `/servicios/${service.id}` && 'is-active']}
                        >
                          {service.data.title}
                        </a>
                      ))}
                      <div class="site-dd-sep"></div>
                      <a href="/servicios" class="site-dd-item site-dd-all">Ver todos los servicios</a>
                    </div>
                    <a href="/servicios/rehabilitacion-sin-obra" class="site-dd-photo">
                      <img src="/2026/05/Bluered3.jpg" alt="Rehabilitación sin obra" />
                      <span>Sin obra</span>
                    </a>
                  </div>
                </li>
              ) : (
                <li>
                  <a href={item.href} class:list={['site-nav-link', isActive(item.href) && 'is-active']}>
                    <span class="site-nav-text">{item.label}</span>
                  </a>
                </li>
              )
            )
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <a href={whatsapp} class="btn btn-whatsapp site-nav-cta hidden lg:inline-flex">WhatsApp</a>
        <a href={telHref} class="btn btn-secondary site-nav-cta">
          <span class="sm:hidden">Llamar</span>
          <span class="hidden sm:inline">{site.phoneDisplay}</span>
        </a>
        <button
          type="button"
          class="grid size-9 place-items-center rounded-md text-white lg:hidden"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Abrir menú"
        >
          <svg data-menu-open xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg data-menu-close xmlns="http://www.w3.org/2000/svg" class="hidden size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>
    </div>
    </div>

    <div id="mobile-nav" class="site-menu bg-base-100 lg:hidden" data-menu hidden>
    <nav class="page-wrap flex flex-col py-3" aria-label="Móvil">
      {
        nav.map((item) =>
          item.href === '/servicios' ? (
            <div data-mobile-dd>
              <button
                type="button"
                class:list={[
                  'flex w-full items-center justify-between rounded-md px-2 py-3 text-left text-base font-medium',
                  servicesOpen ? 'text-secondary' : 'text-primary',
                ]}
                aria-expanded="false"
              >
                {item.label}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 opacity-60" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
                </svg>
              </button>
              <div class="mb-1 ml-2 hidden flex-col border-l border-base-300 pl-3" data-mobile-dd-panel>
                <a href="/servicios" class:list={['rounded-md px-2 py-2 text-sm', path === '/servicios' ? 'font-medium text-secondary' : 'text-primary/80']}>
                  Todos los servicios
                </a>
                {services.map((service) => (
                  <a
                    href={`/servicios/${service.id}`}
                    class:list={[
                      'rounded-md px-2 py-2 text-sm',
                      path === `/servicios/${service.id}` ? 'font-medium text-secondary' : 'text-primary/80',
                    ]}
                  >
                    {service.data.title}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={[
                'rounded-md px-2 py-3 text-base font-medium',
                isActive(item.href) ? 'text-secondary' : 'text-primary',
              ]}
            >
              {item.label}
            </a>
          )
        )
      }
      <div class="mt-2 grid grid-cols-2 gap-2 pb-2">
        <a href={telHref} class="btn btn-white site-nav-cta">Llamar</a>
        <a href={whatsapp} class="btn btn-whatsapp site-nav-cta">WhatsApp</a>
      </div>
    </nav>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = header?.querySelector<HTMLElement>('[data-menu]');
  const iconOpen = header?.querySelector<HTMLElement>('[data-menu-open]');
  const iconClose = header?.querySelector<HTMLElement>('[data-menu-close]');

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  };

  toggle?.addEventListener('click', () => setOpen(Boolean(menu?.hidden)));
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  const desktopDd = header?.querySelector<HTMLElement>('[data-nav-dd]');
  const desktopTrigger = desktopDd?.querySelector<HTMLButtonElement>('.site-dd-trigger');

  const setDesktopOpen = (open: boolean) => {
    if (!desktopDd || !desktopTrigger) return;
    desktopDd.classList.toggle('is-open', open);
    desktopTrigger.setAttribute('aria-expanded', String(open));
  };

  desktopTrigger?.addEventListener('click', (event) => {
    event.stopPropagation();
    setDesktopOpen(!desktopDd?.classList.contains('is-open'));
  });

  document.addEventListener('click', (event) => {
    if (!desktopDd?.contains(event.target as Node)) setDesktopOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setDesktopOpen(false);
  });

  const mobileDd = header?.querySelector<HTMLElement>('[data-mobile-dd]');
  const mobileTrigger = mobileDd?.querySelector<HTMLButtonElement>('button');
  const mobilePanel = mobileDd?.querySelector<HTMLElement>('[data-mobile-dd-panel]');

  mobileTrigger?.addEventListener('click', () => {
    const open = mobilePanel?.classList.contains('hidden');
    mobilePanel?.classList.toggle('hidden', !open);
    mobilePanel?.classList.toggle('flex', Boolean(open));
    mobileTrigger.setAttribute('aria-expanded', String(open));
  });
</script>
