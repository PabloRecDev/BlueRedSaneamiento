---
import { getCollection } from 'astro:content';
import { mapsHref, nav, site, telHref, whatsappHref } from '../lib/site';
import Logo from './Logo.astro';
import ServiceArt from './ServiceArt.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const services = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
const servicesOpen = path === '/servicios' || path.startsWith('/servicios/');
const whatsapp = whatsappHref('Hola, necesito ayuda con un problema de saneamiento.');

function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}
---

<header data-header class="site-header sticky top-0 z-50">
  <div class="site-topbar">
    <div class="page-wrap site-topbar-inner">
      <p class="site-topbar-status">
        <span class="site-topbar-dot" aria-hidden="true"></span>
        <span>Urgencias 24h / 365 días</span>
        <span class="site-topbar-meta hidden sm:inline">
          <a href={mapsHref}>{site.address.city}, {site.address.region}</a>
        </span>
      </p>
      <div class="site-topbar-links">
        <a href={`mailto:${site.email}`} class="site-topbar-link hidden md:inline-flex">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z"></path>
            <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z"></path>
          </svg>
          {site.email}
        </a>
        <a href={whatsapp} class="site-topbar-link" aria-label="WhatsApp">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.06 22l5.25-1.38c1.45.79 3.08 1.21 4.73 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01Zm-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.26 8.26 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.22 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.4-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.18-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42h-.48c-.17 0-.43.06-.66.31-.22.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74 1.64.71 2.06.78 2.8.66.43-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"
            ></path>
          </svg>
          <span class="hidden sm:inline">WhatsApp</span>
        </a>
      </div>
    </div>
  </div>

  <div class="site-nav">
    <div class="page-wrap site-nav-bar">
      <Logo />

      <nav class="site-nav-links" aria-label="Principal">
        <ul>
          {
            nav.map((item) =>
              item.href === '/servicios' ? (
                <li class="site-dd" data-nav-dd>
                  <button
                    type="button"
                    class:list={['site-nav-link site-dd-trigger', servicesOpen && 'is-active']}
                    aria-expanded="false"
                    aria-haspopup="true"
                  >
                    {item.label}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="site-dd-chevron" aria-hidden="true">
                      <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
                    </svg>
                  </button>
                  <div class="site-dd-menu">
                    <div class="site-dd-panel">
                      <div class="page-wrap site-dd-grid">
                        {
                          services.map((service) => (
                            <a
                              href={`/servicios/${service.id}`}
                              class:list={['site-dd-item', path === `/servicios/${service.id}` && 'is-active']}
                            >
                              <span class="site-dd-art">
                                <ServiceArt id={service.id} />
                              </span>
                              <span class="site-dd-item-copy">
                                <span class="site-dd-item-title">{service.data.title}</span>
                                <span class="site-dd-item-kicker">{service.data.eyebrow}</span>
                              </span>
                            </a>
                          ))
                        }
                      </div>
                      <div class="page-wrap">
                        <a href="/servicios" class="site-dd-all">Ver todos los servicios</a>
                      </div>
                    </div>
                  </div>
                </li>
              ) : (
                <li>
                  <a href={item.href} class:list={['site-nav-link', isActive(item.href) && 'is-active']}>
                    {item.label}
                  </a>
                </li>
              )
            )
          }
        </ul>
      </nav>

      <div class="site-nav-end">
        <a href={telHref} class="site-nav-phone" aria-label={`Llamar ${site.phoneDisplay}`}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z" clip-rule="evenodd"></path>
          </svg>
          <span class="sm:hidden">Llamar</span>
          <span class="hidden sm:inline">{site.phoneDisplay}</span>
        </a>
        <button
          type="button"
          class="site-nav-burger"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Abrir menú"
        >
          <svg data-menu-open xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg data-menu-close class="hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-nav" class="site-menu lg:hidden" data-menu hidden>
    <nav class="page-wrap" aria-label="Móvil">
      {
        nav.map((item) =>
          item.href === '/servicios' ? (
            <div data-mobile-dd>
              <button type="button" class:list={['site-menu-link', servicesOpen && 'is-active']} aria-expanded="false">
                {item.label}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
                </svg>
              </button>
              <div class="site-menu-sub hidden" data-mobile-dd-panel>
                <a href="/servicios" class:list={[path === '/servicios' && 'is-active']}>Todos los servicios</a>
                {
                  services.map((service) => (
                    <a href={`/servicios/${service.id}`} class:list={[path === `/servicios/${service.id}` && 'is-active']}>
                      {service.data.title}
                    </a>
                  ))
                }
              </div>
            </div>
          ) : (
            <a href={item.href} class:list={['site-menu-link', isActive(item.href) && 'is-active']}>
              {item.label}
            </a>
          )
        )
      }
      <a href={telHref} class="site-menu-phone">Llamar {site.phoneDisplay}</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = header?.querySelector<HTMLElement>('[data-menu]');
  const iconOpen = header?.querySelector<HTMLElement>('[data-menu-open]');
  const iconClose = header?.querySelector<HTMLElement>('[data-menu-close]');

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  };

  toggle?.addEventListener('click', () => setOpen(Boolean(menu?.hidden)));
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  const desktopDd = header?.querySelector<HTMLElement>('[data-nav-dd]');
  const desktopTrigger = desktopDd?.querySelector<HTMLButtonElement>('.site-dd-trigger');
  let desktopCloseTimer: number | undefined;

  const setDesktopOpen = (open: boolean) => {
    if (!desktopDd || !desktopTrigger) return;
    desktopDd.classList.toggle('is-open', open);
    desktopTrigger.setAttribute('aria-expanded', String(open));
  };

  desktopTrigger?.addEventListener('click', (event) => {
    event.stopPropagation();
    window.clearTimeout(desktopCloseTimer);
    setDesktopOpen(!desktopDd?.classList.contains('is-open'));
  });

  desktopDd?.addEventListener('mouseenter', () => {
    window.clearTimeout(desktopCloseTimer);
    setDesktopOpen(true);
  });

  desktopDd?.addEventListener('mouseleave', () => {
    desktopCloseTimer = window.setTimeout(() => setDesktopOpen(false), 140);
  });

  document.addEventListener('click', (event) => {
    if (!desktopDd?.contains(event.target as Node)) setDesktopOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setDesktopOpen(false);
  });

  const mobileDd = header?.querySelector<HTMLElement>('[data-mobile-dd]');
  const mobileTrigger = mobileDd?.querySelector<HTMLButtonElement>('button');
  const mobilePanel = mobileDd?.querySelector<HTMLElement>('[data-mobile-dd-panel]');

  mobileTrigger?.addEventListener('click', () => {
    const open = mobilePanel?.classList.contains('hidden');
    mobilePanel?.classList.toggle('hidden', !open);
    mobilePanel?.classList.toggle('flex', Boolean(open));
    mobileTrigger.setAttribute('aria-expanded', String(open));
  });
</script>
