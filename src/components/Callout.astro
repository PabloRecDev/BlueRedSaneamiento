---
interface Props {
  label?: string;
}

const { label = 'Ten en cuenta' } = Astro.props;
---

<aside class="alert my-8 rounded-md border border-base-300 bg-base-200">
  <div>
    <p class="text-sm font-semibold text-primary">{label}</p>
    <div class="mt-1 text-sm leading-relaxed text-base-content/80">
      <slot />
    </div>
  </div>
</aside>
