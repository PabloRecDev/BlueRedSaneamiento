<script>
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const header = document.querySelector<HTMLElement>('[data-header]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const setHeader = (y = window.scrollY) => {
    header?.classList.toggle('is-scrolled', y > 8);
  };

  setHeader();
  window.addEventListener('scroll', () => setHeader(), { passive: true });

  if (!reduce) {
    const lenis = new Lenis({ lerp: 0.1 });
    lenis.on('scroll', (event) => {
      ScrollTrigger.update();
      setHeader(event.scroll);
    });
    gsap.ticker.add((time) => lenis.raf(time * 1000));
    gsap.ticker.lagSmoothing(0);

    ScrollTrigger.batch('[data-reveal]', {
      start: 'top 88%',
      onEnter: (batch) => {
        gsap.fromTo(
          batch,
          { x: -28 },
          {
            x: 0,
            duration: 1.05,
            stagger: 0.09,
            ease: 'power3.out',
            overwrite: true,
            onComplete() {
              gsap.set(batch, { clearProps: 'transform' });
            },
          },
        );
      },
    });

    if (document.querySelector('[data-hero]')) {
      gsap.fromTo(
        '[data-hero-item]',
        { x: -22 },
        {
          x: 0,
          duration: 1.1,
          stagger: 0.1,
          ease: 'power3.out',
          onComplete() {
            gsap.set('[data-hero-item]', { clearProps: 'transform' });
          },
        },
      );
    }

    const process = document.querySelector<HTMLElement>('[data-process]');
    const processSteps = process?.querySelectorAll<HTMLElement>('[data-process-step]');

    const setProcess = (progress: number) => {
      if (!process || !processSteps?.length) return;
      process.style.setProperty('--process', String(progress));
      const last = processSteps.length - 1;
      processSteps.forEach((step, i) => {
        const start = last === 0 ? 0 : i / last;
        const next = last === 0 ? 1 : (i + 1) / last;
        const active = progress >= start - 0.001;
        step.classList.toggle('is-active', active);
        step.classList.toggle('is-current', active && (i === last || progress < next));
      });
    };

    if (process && processSteps?.length) {
      const mm = gsap.matchMedia();
      mm.add('(min-width: 900px)', () => {
        ScrollTrigger.create({
          trigger: process,
          start: 'top 22%',
          end: '+=130%',
          pin: true,
          pinSpacing: true,
          scrub: 0.45,
          onUpdate: (self) => setProcess(self.progress),
        });
        return () => setProcess(0);
      });
      mm.add('(max-width: 899px)', () => {
        ScrollTrigger.create({
          trigger: process,
          start: 'top 72%',
          end: 'bottom 38%',
          scrub: 0.35,
          onUpdate: (self) => setProcess(self.progress),
        });
        return () => setProcess(0);
      });
    }
  } else {
    document.querySelector<HTMLElement>('[data-process]')?.style.setProperty('--process', '1');
    document.querySelectorAll('[data-process-step]').forEach((step) => {
      step.classList.add('is-active');
    });
  }

  const form = document.querySelectorAll<HTMLFormElement>('[data-contact-form]');

  form.forEach((formEl) => {
    formEl.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = formEl.querySelector<HTMLElement>('[data-form-status]');
      status?.classList.remove('hidden');
      if (status) status.textContent = 'Enviando…';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          body: new FormData(formEl),
        });
        const json = (await response.json()) as { ok?: boolean; href?: string; message?: string };
        if (json.href) {
          window.location.href = json.href;
          return;
        }
        if (status) status.textContent = json.message ?? 'Consulta enviada. Te llamamos.';
        if (json.ok !== false) formEl.reset();
      } catch {
        if (status) status.textContent = 'No se pudo enviar. Usa WhatsApp o llama.';
      }
    });
  });
</script>
