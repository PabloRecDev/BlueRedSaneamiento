---
interface Props {
  compact?: boolean;
  tone?: 'light' | 'dark';
}

const { compact = false } = Astro.props;
---

<a href="/" class="inline-flex shrink-0 items-center" aria-label="Blue Red Saneamientos">
  <img
    src="/logo-bluered.png"
    alt="Blue Red, líderes en saneamiento"
    width="1024"
    height="230"
    class:list={[compact ? 'h-7' : 'h-9 sm:h-10', 'w-auto']}
  />
</a>
