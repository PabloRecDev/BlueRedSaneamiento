---
import ContactForm from './ContactForm.tsx';

const mosaic = [
  {
    src: '/2023/05/obras-poceria-en-madrid-cuadrada.webp',
    alt: 'Obra de pocería Blue Red',
  },
  {
    src: '/2026/05/Bluered1.jpg',
    alt: 'Inspección con cámara de tuberías',
  },
  {
    src: '/2023/05/localizacion-redes-ocultas.webp',
    alt: 'Localización de redes ocultas',
  },
  {
    src: '/2023/05/sistema-fresado-tuberias-cuadrada.webp',
    alt: 'Fresado de tuberías',
  },
];
---

<section data-hero class="hero-stage">
  <div class="hero-layout">
    <div class="hero-copy">
      <p class="hero-badge" data-hero-item>24 horas · 365 días</p>
      <h1 class="hero-title" data-hero-item>
        Reparación de tuberías
        <span>sin obra</span>
      </h1>
      <p class="hero-lead" data-hero-item>
        Pocería · inspección TV · mantenimiento · obras · rehabilitación. Desatrancos 24h en
        Madrid, Leganés y el sur metropolitano.
      </p>
      <div class="hero-form-card" data-hero-item>
        <ContactForm idPrefix="hero-" compact appearance="hero" />
      </div>
    </div>

    <div class="hero-mosaic" data-hero-item>
      <div class="hero-mosaic-col">
        <figure class="hero-mosaic-shot is-tall">
          <img src={mosaic[0].src} alt={mosaic[0].alt} width="1024" height="1024" />
        </figure>
        <figure class="hero-mosaic-shot">
          <img src={mosaic[2].src} alt={mosaic[2].alt} width="1200" height="800" />
        </figure>
      </div>
      <div class="hero-mosaic-col">
        <figure class="hero-mosaic-shot">
          <img src={mosaic[1].src} alt={mosaic[1].alt} width="1200" height="800" />
        </figure>
        <figure class="hero-mosaic-shot is-tall">
          <img src={mosaic[3].src} alt={mosaic[3].alt} width="1200" height="1200" />
        </figure>
      </div>
    </div>
  </div>
</section>
