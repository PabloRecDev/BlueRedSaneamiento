---

<div class="page-wrap services-showcase" data-services-showcase>
  <div class="services-split">
    <div class="services-copy">
      <div class="services-showcase-head">
        <p class="services-showcase-kicker">Nuestros servicios · 24 horas · 365 días</p>
        <h2 id="servicios-home" class="services-showcase-title">
          Reparamos tuberías sin obras innecesarias
        </h2>
      </div>

      <div class="services-acc">
        {
          services.map((service, i) => (
            <a
              href={`/servicios/${service.id}`}
              class:list={['services-acc-item', i === 0 && 'is-active']}
              data-service-item
              data-service-id={service.id}
              aria-expanded={i === 0 ? 'true' : 'false'}
            >
              <span class="services-acc-head">
                <span class="services-acc-icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d={icons[service.id]}></path>
                  </svg>
                </span>
                <span class="services-acc-name">{service.data.title}</span>
              </span>
              <span class="services-acc-body">
                <span class="services-acc-desc">{service.data.description}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="services-visual" aria-hidden="true">
      {
        services.map((service, i) => (
          <img
            src={images[service.id] ?? fallback}
            alt=""
            width="1200"
            height="800"
            class:list={[i === 0 && 'is-active']}
            data-service-visual={service.id}
          />
        ))
      }
    </div>
  </div>

  <a href="/contacto" class="services-showcase-note">
    <span aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <path
          fill-rule="evenodd"
          d="M4.804 21.644A6.707 6.707 0 0 0 6 21.75a6.721 6.721 0 0 0 3.583-1.029c.774.182 1.584.279 2.417.279 5.322 0 9.75-3.97 9.75-9 0-5.03-4.428-9-9.75-9s-9.75 3.97-9.75 9c0 2.409 1.025 4.59 2.698 6.224.332.313.536.737.536 1.182v.392a.75.75 0 0 1-1.028.681 6.73 6.73 0 0 1-1.602-.627Z"
          clip-rule="evenodd"></path>
      </svg>
    </span>
    <span>Atasco, fuga o bajante: salimos hoy.</span>
    <strong>Pedir inspección</strong>
  </a>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-services-showcase]');
  const items = root?.querySelectorAll<HTMLElement>('[data-service-item]');
  const visuals = root?.querySelectorAll<HTMLElement>('[data-service-visual]');

  const activate = (item: HTMLElement) => {
    const id = item.dataset.serviceId;
    items?.forEach((el) => {
      const on = el === item;
      el.classList.toggle('is-active', on);
      el.setAttribute('aria-expanded', String(on));
    });
    visuals?.forEach((el) => {
      el.classList.toggle('is-active', el.getAttribute('data-service-visual') === id);
    });
  };

  items?.forEach((item) => {
    item.addEventListener('mouseenter', () => activate(item));
    item.addEventListener('focusin', () => activate(item));
    item.addEventListener('click', (event) => {
      if (!item.classList.contains('is-active')) {
        event.preventDefault();
        activate(item);
      }
    });
  });
</script>
